# =====================================================================
# DecentraCloud — environment configuration (TEMPLATE)
#
# Copy this file to ".env" and fill in your own values:
#     copy .env.example .env        (Windows)
#     cp .env.example .env          (Linux / macOS)
#
# NEVER commit the real .env file or any service-account key to GitHub.
# .env, *.json keys and .secret_key are all in .gitignore.
# =====================================================================

# ---------- Flask ----------
# Generate a long random value, e.g.:  python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=replace-with-a-long-random-string
# 1 = debug mode (development only — never enable in production)
FLASK_DEBUG=0
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
# Maximum upload size in megabytes
MAX_FILE_SIZE_MB=50

# ---------- Google Cloud Storage (the 3 cloud storage nodes) ----------
# Your Google Cloud project id (Console -> Project settings)
GOOGLE_CLOUD_PROJECT=your-project-id

# Path to your service-account key file (keep this file PRIVATE, never upload it).
# Alternative (for local development): run  gcloud auth application-default login
# and leave this variable unset.
GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/service-account-key.json

# The three independent buckets — one per storage node.
# Names must be GLOBALLY unique; append your own suffix.
GCS_BUCKET_NODE_1=decentracloud-node-1-your-suffix
GCS_BUCKET_NODE_2=decentracloud-node-2-your-suffix
GCS_BUCKET_NODE_3=decentracloud-node-3-your-suffix

# gcs (default) = real Google Cloud Storage.
# local         = offline development with local folders only (NOT for the demo).
STORAGE_BACKEND=gcs

# ---------- Optional storage locations ----------
# SQLite database (users / files / shares). Default: ./decentracloud.db
# DATABASE_PATH=decentracloud.db
# Blockchain ledger file. Default: ./ledger.json
# LEDGER_FILE=ledger.json
